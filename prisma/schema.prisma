generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER & AUTHENTICATION
// ==========================================

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  phoneNumber  String?  @unique
  avatarUrl    String?
  specialty    String?
  role         Role     @default(OWNER)
  isDelete     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  pets             Pet[]
  customerBookings Booking[]        @relation("CustomerBookings")
  assignedServices BookingService[] @relation("StaffServices")
}

// ==========================================
// 2. PET MANAGEMENT
// ==========================================

model Pet {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  species      String // Người dùng tự nhập (ví dụ: Chó, Mèo...)
  breed        String? // Người dùng tự nhập (ví dụ: Golden Retriever, Poodle...)
  gender       PetGender @default(UNKNOWN)
  birthDate    DateTime?
  weight       Float
  avatarUrl    String?
  allergyNotes String?
  specialNotes String?
  isDelete     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  bookings Booking[]

  @@index([userId])
}

// ==========================================
// 3. SERVICES
// ==========================================

model Service {
  id              Int             @id @default(autoincrement())
  category        ServiceCategory
  name            String
  description     String?
  durationMinutes Int
  basePrice       Int
  imageUrl        String?
  isDelete        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  bookingServices BookingService[]
}

// ==========================================
// 4. BOOKING MANAGEMENT
// ==========================================

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation("CustomerBookings", fields: [userId], references: [id])
  petId       Int
  pet         Pet           @relation(fields: [petId], references: [id])
  bookingType BookingType
  status      BookingStatus @default(PENDING)

  expectedCheckInDate  DateTime?
  expectedCheckOutDate DateTime?

  isDelete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookingServices     BookingService[]
  bookingBoardingRoom BookingBoardingRoom?

  @@index([userId])
  @@index([petId])
  @@index([bookingType])
  @@index([status])
}

model BookingService {
  id              Int               @id @default(autoincrement())
  bookingId       Int
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId       Int
  service         Service           @relation(fields: [serviceId], references: [id])
  staffId         Int?
  staff           User?             @relation("StaffServices", fields: [staffId], references: [id])
  actualStartTime DateTime?
  actualEndTime   DateTime?
  status          ServiceItemStatus @default(PENDING)
  imageUrl        String?
  price           Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([bookingId])
  @@index([staffId])
}

model BookingBoardingRoom {
  id             Int          @id @default(autoincrement())
  bookingId      Int          @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  boardingRoomId Int
  boardingRoom   BoardingRoom @relation(fields: [boardingRoomId], references: [id])
  pricePerHour   Int

  @@index([boardingRoomId])
}

// ==========================================
// 5. BOARDING ROOM MANAGEMENT
// ==========================================

model BoardingRoom {
  id           Int        @id @default(autoincrement())
  name         String     @unique // Tên phòng/chuồng (ví dụ: "Phòng VIP 01", "Chuồng Standard 02")
  description  String
  imageUrl     String?
  pricePerHour Int
  status       RoomStatus @default(AVAILABLE)
  isDelete     Boolean    @default(false)

  // Relations
  bookingBoardingRooms BookingBoardingRoom[]
}

// ==========================================
// 6. ENUMS
// ==========================================

enum Role {
  ADMIN
  STAFF
  OWNER
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum ServiceCategory {
  // Common / Grooming
  CHECK_IN
  BATH_AND_DRY
  HAIRCUT
  HYGIENE
  FULL_GROOMING
  CHECK_OUT

  // Boarding
  ASSIGN_ROOM // Boarding: Đưa bé vào phòng/chuồng đã đặt
  FEEDING // Boarding: Cho ăn theo khẩu phần
  WATER // Boarding: Cung cấp nước / thay nước
  WALKING // Boarding: Dắt bé ra ngoài đi dạo
  MEDICATION // Boarding: Cho uống thuốc
  CLEANING // Boarding: Vệ sinh chuồng trại
  DAILY_HEALTH_CHECK // Boarding: Kiểm tra sức khỏe hàng ngày
}

enum BookingType {
  GROOMING
  BOARDING
}

enum BookingStatus {
  PENDING // Chờ tiếp nhận / chờ xử lý
  CONFIRMED // Đã tiếp nhận đơn booking
  IN_PROGRESS // Đang thực hiện dịch vụ
  COMPLETED // Hoàn tất (Done)
  CANCELLED // Đã hủy (Cancel)
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum ServiceItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
